# ---- Frontier providers (ALL OPTIONAL -- $$ per token) ----
# The lab runs fully local without any of these. Add one only when a project
# explicitly needs a frontier comparison, and set the cost guardrails below.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---- Local inference (free) ----
# Option A (recommended if you run a gateway): set LOCAL_LLM_BASE_URL to any
# OpenAI-compatible endpoint (LiteLLM, vLLM, Ollama's /v1) and use its model
# aliases as model names, e.g. LOCAL_MODEL=coding-agent.
# Option B: leave LOCAL_LLM_BASE_URL empty to talk to Ollama natively.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=sk-dummy-key
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.1:8b
LOCAL_MULTILINGUAL_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ---- Default models ----
# Local-first: point these at local models/aliases. Frontier names (claude-*,
# gpt-*) route to paid APIs and require the matching key above.
DEFAULT_FRONTIER_MODEL=claude-sonnet-4-6
JUDGE_MODEL=claude-sonnet-4-6

# ---- Postgres / pgvector ----
DATABASE_URL=postgresql://lab:changeme_locally@localhost:5432/lab

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333

# ---- Langfuse (observability) ----
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Cost guardrails (USD) ----
MAX_COST_PER_RUN=2.00
MAX_COST_PER_EVAL_SUITE=10.00
